// TE-5R1 opposing-face total-pressure structural rupture.
struct Params { cell_count:u32,threads_x:u32,width:u32,height:u32,chunk_size:u32,chunks_x:u32,chunks_y:u32,sleep_enabled:u32 };
@group(0) @binding(0) var<uniform> params:Params;@group(0) @binding(1) var<storage,read> material_current:array<u32>;@group(0) @binding(2) var<storage,read> pressure_current:array<f32>;@group(0) @binding(3) var<storage,read> rupture_threshold_table:array<f32>;@group(0) @binding(4) var<storage,read> air_energy_current:array<f32>;@group(0) @binding(5) var<storage,read_write> material_next:array<u32>;@group(0) @binding(6) var<storage,read_write> temperature_next:array<f32>;@group(0) @binding(7) var<storage,read_write> flags_next:array<u32>;@group(0) @binding(8) var<storage,read> chunk_state:array<u32>;
const EMPTY:u32=0u;const TABLE_LEN:u32=16u;const STANDARD:f32=293.15;const PMAX:f32=1.0e6;const TREF:f32=20.0;
fn finite(v:f32)->bool{return v==v&&abs(v)<=1.0e20;}fn clean(v:f32)->f32{return clamp(select(0.0,v,finite(v)),0.0,PMAX);}fn inside(x:i32,y:i32)->bool{return x>=0&&y>=0&&x<i32(params.width)&&y<i32(params.height);}fn at(x:i32,y:i32)->u32{return u32(y)*params.width+u32(x);}
fn total(x:i32,y:i32)->f32{if(!inside(x,y)){return 0.0;}let i=at(x,y);let air=select(0.0,max(air_energy_current[i],0.0)/STANDARD,material_current[i]==EMPTY&&finite(air_energy_current[i]));return clean(pressure_current[i])+air;}
@compute @workgroup_size(64,1,1) fn rupture_main(@builtin(global_invocation_id) gid:vec3<u32>){let i=gid.y*params.threads_x+gid.x;if(i>=params.cell_count){return;}if(params.sleep_enabled!=0u){let cx=(i%params.width)/params.chunk_size;let cy=(i/params.width)/params.chunk_size;if(chunk_state[cy*params.chunks_x+cx]!=0u){material_next[i]=material_current[i];return;}}let m=material_current[i];if(m==EMPTY||m>=TABLE_LEN){material_next[i]=m;return;}let limit=rupture_threshold_table[m];if(!(limit>0.0)){material_next[i]=m;return;}let x=i32(i%params.width);let y=i32(i/params.width);let stress=max(abs(total(x-1,y)-total(x+1,y)),abs(total(x,y-1)-total(x,y+1)));if(stress>=limit){material_next[i]=EMPTY;temperature_next[i]=TREF;flags_next[i]=0u;}else{material_next[i]=m;}}
